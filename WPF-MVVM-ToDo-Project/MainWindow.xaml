<Window
    x:Class="WPF_MVVM_ToDo_Project.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_MVVM_ToDo_Project"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Sara's C# WPF MVVM 'Planify' – yet another Todo application."
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">
    <!--  Application shell  -->
    <!--  https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/styles-templates-overview?source=recommendations  -->
    <!--  https://wpf-tutorial.com/control-concepts/tooltips/  -->
    <!--  Not implemented but interesting...:  -->
    <!--  https://intellitect.com/blog/getting-started-material-design-in-xaml/  -->
    <!--  To check out in the fututer...:  -->
    <!--  https://mahapps.com/  -->
    <Grid Background="#FFF2F2F2">
        <!--  Top navigation and main area  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Navigation menu  -->
        <StackPanel
            Margin="8"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <!--  My app logo  -->
            <Image
                Height="38"
                Margin="8,0,4,0"
                VerticalAlignment="Center"
                Source="/Assets/Images/planify_logo.png" />
            <!--  App name  -->
            <TextBlock
                Margin="4,0,500,0"
                VerticalAlignment="Center"
                FontSize="40"
                FontWeight="Bold"
                Foreground="#00B8D3"
                Text="Planify" />
            <!--  Activity list view / standard  -->
            <Button
                Width="180"
                Height="50"
                Margin="16"
                Command="{Binding ShowTodoListCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,5,12,0"
                        FontFamily="Segoe MDL2 Assets"
                        FontWeight="Bold"
                        Text="&#xE700;" />
                    <TextBlock FontSize="16" Text="Show Activity list" />
                </StackPanel>
            </Button>

            <Button
                Width="180"
                Height="50"
                Margin="16"
                Command="{Binding ShowAddTodoCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,5,12,0"
                        FontFamily="Segoe MDL2 Assets"
                        FontWeight="Bold"
                        Text="&#xE710;" />
                    <TextBlock FontSize="16" Text="Add activity" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  Displays the currently active view  -->
        <ContentControl
            Grid.Row="1"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Top"
            Content="{Binding CurrentView}" />
    </Grid>
</Window>
